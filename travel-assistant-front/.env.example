# ==============================
# Travel Assistant Front - Env
# ==============================

# ---------- Mock API（推荐开发模式） ----------
# 启动方式：npm run dev  （同时启动前端 + Mock API）
VITE_API_BASE_URL=http://localhost:3000
VITE_AGENT_API_BASE_URL=http://localhost:3000
VITE_AGENT_WS_URL=ws://localhost:3000/api/ws/agent/stream

# ---------- Real Backend（对接真实后端时启用） ----------
# VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_AGENT_API_BASE_URL=http://localhost:8000
# VITE_AGENT_WS_URL=ws://localhost:8000/ws/agent/stream

# WebSocket/轮询配置
VITE_WS_HEARTBEAT_INTERVAL=30000
VITE_WS_AUTO_RECONNECT=true
VITE_WS_MAX_RETRIES=3
VITE_API_TIMEOUT=30000
VITE_ENABLE_TASK_POLLING=true
VITE_TASK_POLLING_INTERVAL=2000

# 认证配置
VITE_TOKEN_REFRESH_THRESHOLD=300000  # 5分钟 (毫秒)
VITE_SESSION_TIMEOUT=604800000  # 7天 (毫秒)

# 应用配置
VITE_APP_NAME=旅游助手
VITE_ENV=development

# 其他配置
VITE_ENABLE_MOCK=false
