# Application
APP_NAME=travel-assistant-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Claude API
# 如果不配置 ANTHROPIC_API_KEY，服务将以 mock 模式运行（Agent 骨架仍可用）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_assistant
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_assistant
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REQUIRE_HTTPS=false
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=true

# Backend API
BACKEND_API_URL=http://localhost:3000/api

# Redis Cache
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Performance
ENABLE_GZIP=true
GZIP_MIN_SIZE=1000
SLOW_REQUEST_THRESHOLD=1.0
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# MCP (Model Context Protocol)
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:8765
MCP_TRANSPORT=stdio

# Java API (Backend Service)
JAVA_API_BASE_URL=http://localhost:8080/api
JAVA_API_TIMEOUT=30
JAVA_API_MAX_RETRIES=3
JAVA_API_AUTH_TOKEN=

# Gradio配置
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# Agent配置
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT=60

# 多媒体配置
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=104857600
