# Mock API 配置
VITE_API_BASE_URL=http://localhost:3000
VITE_AGENT_API_BASE_URL=http://localhost:3000
VITE_AGENT_WS_URL=ws://localhost:3000/api/ws/agent/stream

# JWT 配置（Mock API Server 使用）
JWT_SECRET=dev-mock-secret-key-change-in-production
JWT_EXPIRE_IN=1h
JWT_REFRESH_EXPIRE_IN=7d

# 服务器配置
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NODE_ENV=development

# 其他配置
VITE_ENABLE_MOCK=true
