# Travel Assistant Project - Environment Configuration

# ====================
# DATABASE CONFIGURATION
# ====================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=travel_assistant

# ====================
# JWT AUTHENTICATION
# ====================
# IMPORTANT: Change this to a strong, unique secret in production!
# Generate with: openssl rand -hex 32
# CRITICAL: This JWT_SECRET_KEY MUST be the same across:
#   - Python Agent (travel-assistant-agent)
#   - Java Backend Services (travel-assistant/auth-service)
# Otherwise JWT token forwarding will fail validation!
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================
# REDIS CACHE
# ====================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ====================
# LLM & AGENT CONFIGURATION
# ====================
# API Keys for different providers
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Tier Strategy
LLM_CHEAP_PROVIDER=deepseek
LLM_STANDARD_PROVIDER=qwen-turbo
LLM_POWER_PROVIDER=claude

# Vector Store
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Hybrid Search (RAG)
HYBRID_SEARCH_ENABLED=true
HYBRID_SEARCH_VECTOR_WEIGHT=0.6
HYBRID_SEARCH_BM25_WEIGHT=0.4

# Prompt Cache
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_DIR=.prompt_cache
SYSTEM_PROMPT_CACHE_TTL=86400
TOOL_DEFINITIONS_CACHE_TTL=86400
RAG_CONTEXT_CACHE_TTL=3600

# Cache TTL Configuration (seconds)
CACHE_TTL_SEARCH=3600
CACHE_TTL_RECOMMEND=21600
CACHE_TTL_RAG=3600
CACHE_TTL_BOOKING=1800
CACHE_TTL_USER_PREFS=86400

# DeepAgent
DEEPAGENT_ENABLED=true
DEEPAGENT_SEARCH_MODEL=claude
DEEPAGENT_RECOMMEND_MODEL=claude

# ====================
# BACKEND API CONFIGURATION
# ====================
APP_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PERFORMANCE
ENABLE_GZIP=true
SLOW_REQUEST_THRESHOLD=0.5
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ====================
# FRONTEND CONFIGURATION
# ====================
NODE_ENV=production
VITE_AGENT_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Travel Assistant

# Frontend API Settings
VITE_API_TIMEOUT=30000
VITE_ENABLE_TASK_POLLING=true
VITE_TASK_POLLING_INTERVAL=2000
VITE_TOKEN_REFRESH_THRESHOLD=300000
VITE_SESSION_TIMEOUT=604800000

# ====================
# JAVA BACKEND SERVICES
# ====================
# Java API Gateway (Spring Cloud Gateway - Port 8080)
JAVA_API_BASE_URL=http://localhost:8080/api

# Individual Java Microservices URLs (via Gateway)
JAVA_FLIGHT_SERVICE_URL=http://localhost:8080/api/flights
JAVA_HOTEL_SERVICE_URL=http://localhost:8080/api/hotels
JAVA_BOOKING_SERVICE_URL=http://localhost:8080/api/bookings
JAVA_ATTRACTION_SERVICE_URL=http://localhost:8080/api/attractions
JAVA_RECOMMENDATION_SERVICE_URL=http://localhost:8080/api/recommendations
JAVA_USER_SERVICE_URL=http://localhost:8080/api/users
JAVA_AUTH_SERVICE_URL=http://localhost:8080/api/auth

# Java API Timeout and Retry
JAVA_API_TIMEOUT=30
JAVA_API_MAX_RETRIES=3

# ====================
# PRODUCTION SETTINGS
# ====================
# Set to true in production for HTTPS redirect
ENABLE_HTTPS_REDIRECT=false

# High security mode (uncomment in production)
# REQUIRE_HTTPS=true
# MIN_PASSWORD_LENGTH=8
# REQUIRE_SPECIAL_CHARS=true

# ====================
# DEVELOPMENT SETTINGS
# ====================
# Development API endpoints
# VITE_AGENT_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# ====================
# DEPLOYMENT VARIABLES
# ====================
# For CI/CD and container registry
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_TAG=latest

# ====================
# HEALTH CHECK CONFIGURATION
# ====================
# Custom health check intervals (in seconds)
# HEALTHCHECK_INTERVAL=30
# HEALTHCHECK_TIMEOUT=10
# HEALTHCHECK_RETRIES=3

# ====================
# LOGGING
# ====================
# Log retention and level
LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
