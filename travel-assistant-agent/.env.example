# Application
APP_NAME=travel-assistant-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ============ LLM Provider API Keys ============
# DeepSeek (便宜层主力 - ¥0.0014/1k tokens)
DEEPSEEK_API_KEY=
# 阿里云通义千问 (标准层主力 - ¥0.008/1k tokens)
DASHSCOPE_API_KEY=
# 智谱 AI GLM (标准层备选 - ¥0.01/1k tokens)
ZHIPU_API_KEY=
# OpenAI 兼容 (GPT-4o 系列)
OPENAI_API_KEY=
# Anthropic Claude (强力层 - $3/1M tokens)
ANTHROPIC_API_KEY=

# ============ LLM Multi-Model Configuration ============
# 默认模型（用于统一接口）
LLM_DEFAULT_MODEL=gpt-4

# 成本预算控制
LLM_MONTHLY_BUDGET=1000
LLM_DAILY_BUDGET=50

# 模型特定参数（可覆盖通用参数）
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ============ LLM Tier Strategy (模型分层策略) ============
# 便宜层默认提供商：deepseek / qwen-plus / gpt-4o-mini
LLM_CHEAP_PROVIDER=deepseek
# 标准层默认提供商：qwen-turbo / glm-4 / gpt-4o
LLM_STANDARD_PROVIDER=qwen-turbo
# 强力层默认提供商：claude / qwen-max / deepseek-reasoner
LLM_POWER_PROVIDER=claude

# LLM 通用参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ============ Vector Store Configuration ============
VECTOR_STORE_TYPE=faiss  # faiss, pinecone, weaviate
VECTOR_STORE_PATH=./data/vector_store
VECTOR_DIMENSION=1536
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
HYBRID_SEARCH_ENABLED=true
TOP_K_RERANK=5

# ============ Legacy Claude API (保留兼容性) ============
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_assistant
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_assistant
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REQUIRE_HTTPS=false
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=true

# Backend API
BACKEND_API_URL=http://localhost:3000/api

# Redis Cache
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Performance
ENABLE_GZIP=true
GZIP_MIN_SIZE=1000
SLOW_REQUEST_THRESHOLD=1.0
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# MCP (Model Context Protocol)
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:8765
MCP_TRANSPORT=stdio

# Java API (Backend Service)
JAVA_API_BASE_URL=http://localhost:8080/api
JAVA_API_TIMEOUT=30
JAVA_API_MAX_RETRIES=3
JAVA_API_AUTH_TOKEN=

# Java MCP Service
JAVA_MCP_URL=http://localhost:8081
JAVA_MCP_TIMEOUT=10
JAVA_MCP_CACHE_TTL=3600

# Gradio配置
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# Agent配置
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT=60
AGENT_VERSION=1.0.0
DEEPAGENT_ENABLED=true
DEEPAGENT_VERSION=0.2.7

# 多媒体配置
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=104857600

# ============ MCP V2 Configuration (Phase 3.1) ============
MCP_V2_ENABLED=true
MCP_V2_TOOLS_ENABLED=true
MCP_V2_RESOURCES_ENABLED=true
MCP_V2_MAX_WEBSOCKETS=100
MCP_V2_REQUEST_TIMEOUT=30.0

# ============ Agent Skills Framework Configuration (Phase 3.2) ============
SKILLS_ENABLED=true
SKILLS_AUTO_LOAD=true
SKILLS_BUILTIN_ENABLED=true
SKILLS_MAX_EXECUTION_TIME=30.0
SKILLS_PARALLEL_ENABLED=true
SKILLS_COST_TRACKING=true

# ============ Concurrency & Rate Limiting Configuration (Phase 3.3) ============
# Connection Pool
CONNECTION_POOL_MAX_CONNECTIONS=100
CONNECTION_POOL_TIMEOUT=30.0
CONNECTION_POOL_IDLE_TIMEOUT=300.0

# Database Connection Pool
DB_CONNECTION_POOL_ENABLED=true
DB_CONNECTION_POOL_MAX=20

# API Connection Pool
API_CONNECTION_POOL_MAX=100
API_CONNECTION_POOL_TIMEOUT=10.0
API_CONNECTION_POOL_MAX_RETRIES=3

# Memory Pool
MEMORY_POOL_ENABLED=true
MEMORY_POOL_MAX_SIZE=100
MEMORY_POOL_ITEM_SIZE_LIMIT=10485760

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_DEFAULT_RATE=1000.0
RATE_LIMIT_DEFAULT_BURST=2000.0
RATE_LIMIT_PER_USER_RATE=10.0
RATE_LIMIT_PER_USER_BURST=20.0

# Streaming
STREAMING_ENABLED=true
STREAMING_BUFFER_SIZE=1000
STREAMING_FLUSH_INTERVAL=1.0
STREAMING_HEARTBEAT_INTERVAL=30.0
